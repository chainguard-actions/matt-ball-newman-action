{
  "info": {
    "_postman_id": "test-collection-003",
    "name": "No Request Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Script only item",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "console.log('pre-request script ran');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Always passes', function () {",
              "  pm.expect(1).to.equal(1);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://postman-echo.com/get",
          "protocol": "https",
          "host": ["postman-echo", "com"],
          "path": ["get"]
        }
      }
    }
  ]
}
